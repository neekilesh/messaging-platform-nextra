# Server & Application URL
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Frontend Deployment (Netlify)
# Set these in Netlify Site Settings -> Environment Variables when hosting the frontend separately.
VITE_API_BASE_URL=""
VITE_SOCKET_URL=""

# Cryptographic Secrets (generate strong 64-char hex strings in production)
SESSION_SECRET="replace-with-strong-session-secret"
OTP_HMAC_SECRET="replace-with-strong-otp-hmac-secret"

# Cloud SQL (PostgreSQL) Connection Variables (auto-injected in AI Studio)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="nexora"
SQL_USER="nexora_app"
SQL_PASSWORD="replace-with-sql-password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="replace-with-admin-password"

# Encrypted Media Storage Directory
UPLOADS_DIR="./uploads/encrypted"

# Transactional Email OTP Provider (SMTP)
# Leave blank in development/preview to use the built-in OTP verification preview fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NEXORA Security <no-reply@nexora.app>"

# GEMINI_API_KEY (automatically injected by AI Studio if needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
