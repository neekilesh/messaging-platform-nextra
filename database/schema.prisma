generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum GroupRole {
  owner
  admin
  member
}

enum MessageKind {
  text
  image
  video
  voice
  file
  system
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String
  usernameNormalized String    @unique @map("username_normalized")
  displayName        String    @map("display_name")
  emailHash          String    @unique @map("email_hash")
  emailMasked        String    @map("email_masked")
  passwordHash       String    @map("password_hash")
  avatarUrl          String?   @map("avatar_url")
  bio                String    @default("")
  statusText         String    @default("Encrypted on NEXORA") @map("status_text")
  lastSeenAt         DateTime? @map("last_seen_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  devices         Device[]
  sessions        UserSession[]
  identityKey     IdentityKey?
  privacySettings UserPrivacySetting?
  groupMembers    GroupMember[]
  messages        Message[]
  stories         Story[]

  @@map("users")
}

model EmailVerification {
  id                    String   @id @default(uuid()) @db.Uuid
  emailNormalized       String   @map("email_normalized")
  purpose               String
  otpHash               String   @map("otp_hash")
  salt                  String
  attempts              Int      @default(0)
  verified              Boolean  @default(false)
  verificationTokenHash String?  @map("verification_token_hash")
  expiresAt             DateTime @map("expires_at")
  resendAvailableAt     DateTime @map("resend_available_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([emailNormalized, purpose, createdAt])
  @@map("email_verifications")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceName   String   @map("device_name")
  platform     String
  lastActiveAt DateTime @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@map("devices")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  ipAddress    String    @default("") @map("ip_address")
  lastActiveAt DateTime  @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model IdentityKey {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  deviceId           String   @map("device_id")
  ecdhPublicJwk      String   @map("ecdh_public_jwk")
  ecdsaPublicJwk     String   @map("ecdsa_public_jwk")
  encryptedKeyBackup String?  @map("encrypted_key_backup")
  backupSalt         String?  @map("backup_salt")
  backupIv           String?  @map("backup_iv")
  fingerprint        String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_keys")
}

model UserPrivacySetting {
  userId                   String   @id @map("user_id") @db.Uuid
  showOnlineStatus         Boolean  @default(true) @map("show_online_status")
  showReadReceipts         Boolean  @default(true) @map("show_read_receipts")
  allowChatRequests        Boolean  @default(true) @map("allow_chat_requests")
  storyDefaultVisibility   String   @default("friends") @map("story_default_visibility")
  allowDiscoveryByUsername Boolean  @default(true) @map("allow_discovery_by_username")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model Group {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  description  String   @default("")
  avatarUrl    String?  @map("avatar_url")
  privacy      String   @default("private")
  maxMembers   Int      @default(25) @map("max_members")
  creatorId    String   @map("creator_id") @db.Uuid
  currentEpoch Int      @default(1) @map("current_epoch")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members      GroupMember[]
  conversation Conversation?

  @@map("groups")
}

model GroupMember {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        GroupRole @default(member)
  joinedEpoch Int       @default(1) @map("joined_epoch")
  joinedAt    DateTime  @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Conversation {
  id                  String    @id @default(uuid()) @db.Uuid
  type                String
  groupId             String?   @unique @map("group_id") @db.Uuid
  privatePairKey      String?   @unique @map("private_pair_key")
  disappearingSeconds Int       @default(0) @map("disappearing_seconds")
  lastMessageAt       DateTime? @map("last_message_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  group    Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id                 String      @id @default(uuid()) @db.Uuid
  conversationId     String      @map("conversation_id") @db.Uuid
  senderId           String      @map("sender_id") @db.Uuid
  replyToId          String?     @map("reply_to_id") @db.Uuid
  kind               MessageKind @default(text)
  ciphertext         String
  iv                 String
  aad                String
  epoch              Int?
  isPinned           Boolean     @default(false) @map("is_pinned")
  isEdited           Boolean     @default(false) @map("is_edited")
  deletedForEveryone Boolean     @default(false) @map("deleted_for_everyone")
  expiresAt          DateTime?   @map("expires_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Story {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  mediaType  String   @map("media_type")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("stories")
}
