# Server & Application URL
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Cryptographic Secrets (generate strong 64-char hex strings in production)
SESSION_SECRET="replace-with-strong-session-secret"
OTP_HMAC_SECRET="replace-with-strong-otp-hmac-secret"

# Local SQLite Persistence (default embedded relational store)
DATABASE_PATH="./data/nexora.db"
UPLOADS_DIR="./uploads/encrypted"

# Production PostgreSQL & Redis (used with docker-compose.yml / Prisma)
POSTGRES_URL="postgresql://nexora:nexora_password@localhost:5432/nexora?schema=public"
REDIS_URL="redis://localhost:6379"

# Transactional Email OTP Provider (SMTP)
# Leave blank in development to use the console & verification preview fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NEXORA Security <no-reply@nexora.app>"

# GEMINI_API_KEY (automatically injected by AI Studio if needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
